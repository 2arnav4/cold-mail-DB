# ── Sensitive files ───────────────────────────────────────────────────────────
sent_log.json
sent_log_failed.json
sent_log_bounce_state.json
*.db
# Timestamped copies do not match *.db and carry the same contact rows.
*.db.backup*
*.db.bak
__pycache__/
*.pyc
*.pyo
.env

# ── Virtualenvs ───────────────────────────────────────────────────────────────
venv/
.venv/

# ── PDFs (personal) ──────────────────────────────────────────────────────────
*.pdf

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
*.xlsx
bounce_scan.log
sent_log_opens.json


# ── Go build artifacts ────────────────────────────────────────────────────────
# The compiled verifier is ~4.6MB and rebuilds with `go build`. Never commit it.
verifier/verifier
*.exe

# ── Verifier output ───────────────────────────────────────────────────────────
# CSVs written by `verifier -out` contain contact addresses.
verify_results*.csv

# Contact databases stay local. Personal data, never pushed.
hr-database/
data_sources/
# 63 real contact addresses are hardcoded in this script's source.
add_new_hr_contacts.py

# Local sqlite WAL sidecars
*.db-shm
*.db-wal

# ── outreach/ (tier one: per-company email + deck) ────────────────────────────
outreach/node_modules/
# Build artifacts. send.json carries the recipient address, decks are personal.
outreach/out/
# GitHub API digests, regenerate with `npm run research`.
outreach/research/
# Company files carry recipient names and addresses. Same rule as hr-database/.
outreach/companies/*.yaml
!outreach/companies/_template.yaml
!outreach/companies/example-northwind.yaml

# Crawler run logs
harvest_run.log
*_run.log
